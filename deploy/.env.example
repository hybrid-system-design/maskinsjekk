# Copy to deploy/.env (gitignored) on the server and fill in. docker compose
# reads it automatically.

# Optional Bambu Lab bridge (tools/bambu-bridge): uncomment to start it with
# the stack. Serial and LAN access code are on the printer's screen
# (network/WLAN settings); never commit them.
#COMPOSE_PROFILES=bambu
#BAMBU_SERIAL=
#BAMBU_ACCESS_CODE=
# Empty = find the printer by its UDP 2021 announcements (survives IP changes).
#BAMBU_HOST=
#BAMBU_TOPIC=hsd/demo/printer-1/bambu
