{
  "sites": [
    {
      "id": "demo",
      "name": "HSD Demo",
      "machines": [
        {
          "id": "printer-1",
          "name": "3D-printer",
          "sensors": [
            { "id": "esp32-1", "kind": "esp32-vibration" },
            { "id": "bambu", "kind": "bambu-status" },
            { "id": "shelly-1", "kind": "shelly-gen2", "mqtt_prefix": "shelly-printer-1" }
          ],
          "state": {
            "signals": {
              "power": { "sensor": "shelly-1", "metric": "power_w", "window": "60s", "max_age": "10m" },
              "vib": { "sensor": "esp32-1", "metric": "vib_rms", "window": "60s", "max_age": "2m", "optional": true }
            },
            "rules": [
              { "state": "OFF", "when": { "power": { "below": 3 } }, "enter_after": "60s" },
              { "state": "IDLE", "when": { "power": { "below": 20 } }, "enter_after": "60s" },
              { "state": "HEATING", "when": { "vib": { "below": 0.02 } }, "enter_after": "60s" },
              { "state": "RUNNING", "enter_after": "60s" }
            ]
          }
        },
        {
          "id": "sim-printer",
          "name": "Simulert maskin",
          "sensors": [
            { "id": "esp32-1", "kind": "simulator" },
            { "id": "power", "kind": "simulator" }
          ],
          "state": {
            "signals": {
              "power": { "sensor": "power", "metric": "power_w", "window": "30s", "max_age": "2m" },
              "vib": { "sensor": "esp32-1", "metric": "vib_rms", "window": "30s", "max_age": "2m", "optional": true }
            },
            "rules": [
              { "state": "OFF", "when": { "power": { "below": 3 } }, "enter_after": "30s" },
              { "state": "IDLE", "when": { "power": { "below": 20 } }, "enter_after": "30s" },
              { "state": "HEATING", "when": { "vib": { "below": 0.02 } }, "enter_after": "30s" },
              { "state": "RUNNING", "enter_after": "30s" }
            ]
          }
        }
      ]
    }
  ]
}
